//@version=6
// Forever-style SMC Sniper Strategy (v5)
//
// Aligned with the public Forever Model [Pro+] specification
// (toodegrees.trade/indicators/Forever Model). Key fixes vs v4:
//
//   * CISD now matches the official definition: a single candle that
//     sweeps a short-term high/low and closes beyond its own open. The
//     Orderblock IS that CISD candle (not a prior sweeper).
//   * SMT divergence is pivot-based on the correlated chart: our chart
//     swept its STH/STL but the correlated chart did not sweep its own.
//   * Bias options renamed to Forever's own terms: Bullish / Bearish /
//     Neutral. Neutral allows both directions, gated by HTF alignment.
//   * Visuals follow Forever's component list: HTF FVG (IRL) zone with
//     CE midline, sweep marker, OB box, OB projections, ERL line, CISD
//     label, invalidation 'x', dashboard, alerts.
//
// This is an original implementation of the publicly documented
// concepts. It does not reproduce the proprietary closed-source Pine.

strategy(
     title              = "Forever-style SMC Sniper",
     shorttitle         = "SMC Sniper",
     overlay            = true,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 10,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.04,
     pyramiding         = 0,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     dynamic_requests   = true,
     max_boxes_count    = 500,
     max_lines_count    = 500,
     max_labels_count   = 500)

// ============================================================================
//  INPUTS
// ============================================================================
gHTF = "1. HTF Bias (IRL source)"
biasMode = input.string("Neutral", "Bias", options = ["Bullish", "Bearish", "Neutral"], group = gHTF)
htf      = input.timeframe("D", "HTF for IRL FVG", group = gHTF)
showCE   = input.bool(true, "Plot CE (FVG midline)", group = gHTF)

gIRL = "2. IRL Tag"
requireIRLTag    = input.bool(true, "Require IRL tag (price into HTF FVG)", group = gIRL)
maxBarsIRLtoCISD = input.int(40,    "Max bars from IRL tag to CISD", minval = 3, group = gIRL)

gSTR = "3. CISD"
sthLen       = input.int(3,    "Short-term pivot length (STH/STL)", minval = 1, group = gSTR)
cisdMinDispl = input.float(0,  "Min CISD body / ATR (0 = off)", minval = 0, step = 0.1, group = gSTR)

gERL = "4. ERL / OB Projections"
ltLen          = input.int(10,  "Major pivot length (ERL)",      minval = 3, group = gERL)
useERLTarget   = input.bool(true,  "Target next ERL liquidity",           group = gERL)
useOBProj      = input.bool(true,  "Show OB projection levels",           group = gERL)
obProjMults    = input.string("2, 3", "OB projection multipliers (csv)",  group = gERL)
rrFallback     = input.float(2.0, "RR fallback if no ERL ahead", minval = 0.5, step = 0.25, group = gERL)
slBufferTicks  = input.int(2,   "SL buffer (ticks)", minval = 0, group = gERL)

gSMT = "5. SMT Divergence (optional)"
useSMT      = input.bool(false, "Require SMT divergence at sweep", group = gSMT)
useAutoSMT  = input.bool(true,  "Auto-detect SMT pair",            group = gSMT)
smtSym      = input.symbol("BINANCE:ETHUSDT.P", "Manual SMT pair", group = gSMT)
smtInverse  = input.bool(false, "Inverse correlation",             group = gSMT)
use2ndSMT   = input.bool(false, "Use 2nd SMT pair",                group = gSMT)
smtSym2     = input.symbol("CBOT_MINI:YM1!", "2nd SMT pair sym",   group = gSMT)
smt2Inverse = input.bool(false, "2nd Inverse",                     group = gSMT)

gSES = "6. Session Filter (killzones)"
useSession = input.bool(false, "Trade only inside sessions", group = gSES)
sess1      = input.session("0200-0500", "Filter 1", group = gSES)
sess2      = input.session("0800-1200", "Filter 2", group = gSES)
sess3      = input.session("1330-1615", "Filter 3", group = gSES)
sess4      = input.session("2000-2300", "Filter 4", group = gSES)
sessTZ     = input.string("Europe/Berlin", "Timezone", group = gSES)

gVIZ = "7. Visuals"
maxModels        = input.int(40,   "Max model history",              minval = 1, maxval = 200, group = gVIZ)
showOutcomes     = input.bool(true,"Show W/L outcome labels",        group = gVIZ)
showHTFFVG       = input.bool(true,"Plot HTF FVG (IRL) zones",       group = gVIZ)
showOB           = input.bool(true,"Plot Orderblock from CISD",      group = gVIZ)
showERLLine      = input.bool(true,"Plot ERL target line",           group = gVIZ)
showSweep        = input.bool(true,"Plot sweep marker",              group = gVIZ)
showSMTLine      = input.bool(true,"Plot SMT divergence line",       group = gVIZ)
showCISDLabel    = input.bool(true,"Plot CISD label on confirmation",group = gVIZ)
showInvalidation = input.bool(true,"Plot invalidation 'x' marker",   group = gVIZ)
showTable        = input.bool(true,"Dashboard table",                group = gVIZ)

slBuffer = slBufferTicks * syminfo.mintick

// Parse projection multipliers "2, 3" -> [2.0, 3.0]
parseProjMults() =>
    out = array.new<float>()
    parts = str.split(obProjMults, ",")
    if not na(parts)
        for i = 0 to array.size(parts) - 1
            raw = str.replace_all(array.get(parts, i), " ", "")
            v = str.tonumber(raw)
            if not na(v)
                array.push(out, v)
    out
projMults = parseProjMults()

// ============================================================================
//  HTF FVG  -> bias + IRL zones (one persistent box per direction)
// ============================================================================
[htfH1, htfL1, htfH3, htfL3] = request.security(syminfo.tickerid, htf, [high[1], low[1], high[3], low[3]], lookahead = barmerge.lookahead_off)

htfBull = htfL1 > htfH3
htfBear = htfH1 < htfL3

var float htfBullTop = na
var float htfBullBot = na
var float htfBearTop = na
var float htfBearBot = na
var int   htfBias    = 0
var box   htfBullBox = na
var box   htfBearBox = na
var line  bullCELine = na
var line  bearCELine = na

if htfBull
    htfBullTop := htfL1
    htfBullBot := htfH3
    htfBias    := 1
    if showHTFFVG
        if not na(htfBullBox)
            box.delete(htfBullBox)
        if not na(bullCELine)
            line.delete(bullCELine)
        htfBullBox := box.new(left = bar_index - 3, top = htfBullTop, right = bar_index + 5, bottom = htfBullBot, bgcolor = color.new(color.gray, 88), border_color = color.new(color.gray, 70), extend = extend.right)
        if showCE
            ce = (htfBullTop + htfBullBot) / 2
            bullCELine := line.new(bar_index - 3, ce, bar_index + 5, ce, color = color.new(color.gray, 50), style = line.style_dashed, extend = extend.right)
if htfBear
    htfBearTop := htfL3
    htfBearBot := htfH1
    htfBias    := -1
    if showHTFFVG
        if not na(htfBearBox)
            box.delete(htfBearBox)
        if not na(bearCELine)
            line.delete(bearCELine)
        htfBearBox := box.new(left = bar_index - 3, top = htfBearTop, right = bar_index + 5, bottom = htfBearBot, bgcolor = color.new(color.gray, 88), border_color = color.new(color.gray, 70), extend = extend.right)
        if showCE
            ce = (htfBearTop + htfBearBot) / 2
            bearCELine := line.new(bar_index - 3, ce, bar_index + 5, ce, color = color.new(color.gray, 50), style = line.style_dashed, extend = extend.right)

// ============================================================================
//  IRL TAG
// ============================================================================
irlBullTag = htfBias ==  1 and not na(htfBullTop) and low  <= htfBullTop and low  >= htfBullBot
irlBearTag = htfBias == -1 and not na(htfBearBot) and high >= htfBearBot and high <= htfBearTop

var int irlBullTagBar = na
var int irlBearTagBar = na
if irlBullTag
    irlBullTagBar := bar_index
if irlBearTag
    irlBearTagBar := bar_index

irlBullActive = not requireIRLTag or (not na(irlBullTagBar) and bar_index - irlBullTagBar <= maxBarsIRLtoCISD)
irlBearActive = not requireIRLTag or (not na(irlBearTagBar) and bar_index - irlBearTagBar <= maxBarsIRLtoCISD)

// ============================================================================
//  STH / STL pivots = liquidity pools
// ============================================================================
sth = ta.pivothigh(high, sthLen, sthLen)
stl = ta.pivotlow(low,  sthLen, sthLen)
var float lastSTH    = na
var float lastSTL    = na
var int   lastSTHBar = na
var int   lastSTLBar = na
if not na(sth)
    lastSTH    := sth
    lastSTHBar := bar_index - sthLen
if not na(stl)
    lastSTL    := stl
    lastSTLBar := bar_index - sthLen

// ============================================================================
//  CISD  -  Forever's definition:
//      a single candle that sweeps STH/STL and closes beyond its own open.
//      The Orderblock IS this candle.
// ============================================================================
atrV    = ta.atr(20)
displOK = cisdMinDispl <= 0 or math.abs(close - open) >= cisdMinDispl * atrV

bullCISD = not na(lastSTL) and low  < lastSTL and close > open and displOK
bearCISD = not na(lastSTH) and high > lastSTH and close < open and displOK

// ============================================================================
//  SMT  -  pivot-based divergence on the correlated chart
//      Our chart swept its STL/STH; correlated did NOT sweep its own.
// ============================================================================
autoSmtPair() =>
    s     = syminfo.ticker
    base  = syminfo.basecurrency
    quote = syminfo.currency
    typ   = syminfo.type
    string result = smtSym
    if s == "ES1!" or str.startswith(s, "ES1")
        result := "CME_MINI:NQ1!"
    else if s == "NQ1!" or str.startswith(s, "NQ1")
        result := "CME_MINI:ES1!"
    else if s == "YM1!" or s == "RTY1!"
        result := "CME_MINI:ES1!"
    else if typ == "forex" and base == "EUR" and quote == "USD"
        result := "OANDA:GBPUSD"
    else if typ == "forex" and base == "GBP" and quote == "USD"
        result := "OANDA:EURUSD"
    else if typ == "forex" and base == "AUD" and quote == "USD"
        result := "OANDA:NZDUSD"
    else if typ == "forex" and base == "NZD" and quote == "USD"
        result := "OANDA:AUDUSD"
    else if typ == "forex" and base == "USD" and quote == "JPY"
        result := "OANDA:USDCHF"
    else if typ == "forex" and base == "USD" and quote == "CHF"
        result := "OANDA:USDJPY"
    else if str.contains(s, "XAU") or str.contains(s, "GOLD")
        result := "TVC:SILVER"
    else if str.contains(s, "XAG") or str.contains(s, "SILVER")
        result := "TVC:GOLD"
    else if str.contains(s, "BTC")
        result := "BINANCE:ETHUSDT.P"
    else if str.contains(s, "ETH")
        result := "BINANCE:BTCUSDT.P"
    result

smtTargetSym  = useAutoSMT ? autoSmtPair() : smtSym
[smtH,  smtL]  = request.security(smtTargetSym, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)
[smtH2, smtL2] = request.security(smtSym2,      timeframe.period, [high, low], lookahead = barmerge.lookahead_off)

smtPH  = ta.pivothigh(smtH, sthLen, sthLen)
smtPL  = ta.pivotlow(smtL,  sthLen, sthLen)
smt2PH = ta.pivothigh(smtH2, sthLen, sthLen)
smt2PL = ta.pivotlow(smtL2,  sthLen, sthLen)
var float smtLastSTH = na
var float smtLastSTL = na
var float smt2LastSTH = na
var float smt2LastSTL = na
if not na(smtPH)
    smtLastSTH := smtPH
if not na(smtPL)
    smtLastSTL := smtPL
if not na(smt2PH)
    smt2LastSTH := smt2PH
if not na(smt2PL)
    smt2LastSTL := smt2PL

// Divergence rule: our chart swept, correlated did not.
// For bullish CISD (our low < lastSTL): correlated's low must be >= its smtLastSTL.
smt1BullDiv = na(smtLastSTL) or smtL >= smtLastSTL
smt1BearDiv = na(smtLastSTH) or smtH <= smtLastSTH
smt2BullDiv = na(smt2LastSTL) or smtL2 >= smt2LastSTL
smt2BearDiv = na(smt2LastSTH) or smtH2 <= smt2LastSTH

smt1BullOK = smtInverse  ? not smt1BullDiv : smt1BullDiv
smt1BearOK = smtInverse  ? not smt1BearDiv : smt1BearDiv
smt2BullOK = smt2Inverse ? not smt2BullDiv : smt2BullDiv
smt2BearOK = smt2Inverse ? not smt2BearDiv : smt2BearDiv

smtBullOK = not useSMT or (use2ndSMT ? (smt1BullOK or smt2BullOK) : smt1BullOK)
smtBearOK = not useSMT or (use2ndSMT ? (smt1BearOK or smt2BearOK) : smt1BearOK)

// ============================================================================
//  ERL  -  next major swing liquidity beyond internal structure
// ============================================================================
ltPH = ta.pivothigh(high, ltLen, ltLen)
ltPL = ta.pivotlow(low,  ltLen, ltLen)
var float lastLTPH    = na
var float lastLTPL    = na
var int   lastLTPHBar = na
var int   lastLTPLBar = na
var float prevLTPH    = na
var float prevLTPL    = na
var int   prevLTPHBar = na
var int   prevLTPLBar = na
if not na(ltPH)
    prevLTPH    := lastLTPH
    prevLTPHBar := lastLTPHBar
    lastLTPH    := ltPH
    lastLTPHBar := bar_index - ltLen
if not na(ltPL)
    prevLTPL    := lastLTPL
    prevLTPLBar := lastLTPLBar
    lastLTPL    := ltPL
    lastLTPLBar := bar_index - ltLen

// ============================================================================
//  SESSION FILTER
// ============================================================================
inSess(s) => not na(time(timeframe.period, s, sessTZ))
sessionOK = not useSession or inSess(sess1) or inSess(sess2) or inSess(sess3) or inSess(sess4)

// ============================================================================
//  BIAS gate (Forever terms)
//      Neutral  -> show both directions, each gated by HTF alignment
//      Bullish  -> only long formations, HTF alignment skipped
//      Bearish  -> only short formations, HTF alignment skipped
// ============================================================================
bullDirOK = (biasMode == "Bullish") or (biasMode == "Neutral" and htfBias ==  1)
bearDirOK = (biasMode == "Bearish") or (biasMode == "Neutral" and htfBias == -1)

bullSignal = bullCISD and bullDirOK and irlBullActive and smtBullOK and sessionOK and strategy.position_size == 0
bearSignal = bearCISD and bearDirOK and irlBearActive and smtBearOK and sessionOK and strategy.position_size == 0

// ============================================================================
//  MODEL drawing  -  OB box (the CISD candle itself) + projections + ERL +
//                    sweep marker + CISD label.
// ============================================================================
type Model
    int   bar
    int   dir
    float obHigh
    float obLow
    float sl
    box   obBox
    label obLbl
    label cisdLbl
    line  sweepLine
    label sweepLbl
    line  smtLine
    label smtLbl
    line  erlLine
    label erlLbl
    array<line>  projLines
    array<label> projLbls
    bool  invalidated
    label invalidLbl

var array<Model> models = array.new<Model>()

drawModel(int dir, float obH, float obL, float sl, float sweepLvl) =>
    m = Model.new(bar = bar_index, dir = dir, obHigh = obH, obLow = obL, sl = sl, invalidated = false, projLines = array.new<line>(), projLbls = array.new<label>())
    if showOB
        bg = dir == 1 ? color.new(color.teal, 95) : color.new(color.maroon, 95)
        bd = dir == 1 ? color.new(color.teal, 30) : color.new(color.maroon, 30)
        m.obBox := box.new(left = bar_index, top = obH, right = bar_index + 30, bottom = obL, bgcolor = bg, border_color = bd, extend = extend.right)
        obMidPx = (obH + obL) / 2
        m.obLbl := label.new(bar_index + 30, obMidPx, text = "-OB", style = label.style_none, textcolor = bd, size = size.small)
    if showCISDLabel
        col = dir == 1 ? color.new(color.green, 0) : color.new(color.red, 0)
        sty = dir == 1 ? label.style_label_up : label.style_label_down
        ypx = dir == 1 ? low : high
        m.cisdLbl := label.new(bar_index, ypx, text = "CISD", style = sty, color = col, textcolor = color.white, size = size.small)
    if showSweep and not na(sweepLvl)
        m.sweepLine := line.new(bar_index - 4, sweepLvl, bar_index + 2, sweepLvl, color = color.new(color.orange, 0), style = line.style_dotted, width = 1)
        m.sweepLbl  := label.new(bar_index + 2, sweepLvl, text = "✕", style = label.style_none, textcolor = color.new(color.orange, 0), size = size.tiny)
    if showSMTLine
        fromBar = dir == 1 ? prevLTPLBar : prevLTPHBar
        toBar   = dir == 1 ? lastLTPLBar : lastLTPHBar
        fromPx  = dir == 1 ? prevLTPL    : prevLTPH
        toPx    = dir == 1 ? lastLTPL    : lastLTPH
        if not na(fromBar) and not na(toBar) and fromBar < toBar
            m.smtLine := line.new(fromBar, fromPx, toBar, toPx, color = color.new(color.black, 30), width = 1)
            midBar = math.round((fromBar + toBar) / 2)
            midPx  = (fromPx + toPx) / 2
            m.smtLbl  := label.new(midBar, midPx, text = useAutoSMT ? smtTargetSym : smtSym, style = label.style_none, textcolor = color.new(color.black, 30), size = size.tiny)
    body = obH - obL
    if useOBProj and body > 0 and array.size(projMults) > 0
        for j = 0 to array.size(projMults) - 1
            mult  = array.get(projMults, j)
            level = dir == 1 ? obH + body * mult : obL - body * mult
            pl  = line.new(bar_index + 2, level, bar_index + 22, level, color = color.new(color.red, 0), width = 1, style = line.style_solid)
            multTxt = mult == math.round(mult) ? str.tostring(int(mult)) : str.tostring(mult)
            tag = (dir == 1 ? "" : "-") + multTxt
            pll = label.new(bar_index + 22, level, text = tag, style = label.style_none, textcolor = color.red, size = size.small)
            array.push(m.projLines, pl)
            array.push(m.projLbls, pll)
    erlPx = dir == 1 ? lastLTPH : lastLTPL
    if showERLLine and not na(erlPx) and ((dir == 1 and erlPx > obH) or (dir == -1 and erlPx < obL))
        m.erlLine := line.new(bar_index, erlPx, bar_index + 30, erlPx, color = color.new(color.black, 0), width = 1, extend = extend.right)
        m.erlLbl  := label.new(bar_index + 30, erlPx, text = "ERL", style = label.style_none, textcolor = color.new(color.black, 0), size = size.small)
    array.push(models, m)
    while array.size(models) > maxModels
        old = array.shift(models)
        if not na(old.obBox)
            box.delete(old.obBox)
        if not na(old.obLbl)
            label.delete(old.obLbl)
        if not na(old.cisdLbl)
            label.delete(old.cisdLbl)
        if not na(old.sweepLine)
            line.delete(old.sweepLine)
        if not na(old.sweepLbl)
            label.delete(old.sweepLbl)
        if not na(old.smtLine)
            line.delete(old.smtLine)
        if not na(old.smtLbl)
            label.delete(old.smtLbl)
        if not na(old.erlLine)
            line.delete(old.erlLine)
        if not na(old.erlLbl)
            label.delete(old.erlLbl)
        if not na(old.invalidLbl)
            label.delete(old.invalidLbl)
        if array.size(old.projLines) > 0
            for k = 0 to array.size(old.projLines) - 1
                line.delete(array.get(old.projLines, k))
        if array.size(old.projLbls) > 0
            for k = 0 to array.size(old.projLbls) - 1
                label.delete(array.get(old.projLbls, k))

// ============================================================================
//  INVALIDATION  -  close beyond the OB extreme in the wrong direction
// ============================================================================
if array.size(models) > 0
    for j = 0 to array.size(models) - 1
        mm = array.get(models, j)
        if not mm.invalidated
            broken = (mm.dir == 1 and close < mm.obLow) or (mm.dir == -1 and close > mm.obHigh)
            if broken
                mm.invalidated := true
                if showInvalidation
                    yp = mm.dir == 1 ? low : high
                    mm.invalidLbl := label.new(bar_index, yp, text = "x", style = label.style_label_center, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

// ============================================================================
//  ENTRY orders
//      OB = CISD candle itself; SL = OB extreme +/- buffer.
// ============================================================================
if bullSignal
    sl   = low - slBuffer
    risk = close - sl
    if risk > 0
        tpERL = (useERLTarget and not na(lastLTPH) and lastLTPH > close) ? lastLTPH : na
        tp    = na(tpERL) ? close + risk * rrFallback : tpERL
        strategy.entry("L", strategy.long)
        strategy.exit("L-x", "L", stop = sl, limit = tp)
        drawModel(1, high, low, sl, lastSTL)
        irlBullTagBar := na

if bearSignal
    sl   = high + slBuffer
    risk = sl - close
    if risk > 0
        tpERL = (useERLTarget and not na(lastLTPL) and lastLTPL < close) ? lastLTPL : na
        tp    = na(tpERL) ? close - risk * rrFallback : tpERL
        strategy.entry("S", strategy.short)
        strategy.exit("S-x", "S", stop = sl, limit = tp)
        drawModel(-1, high, low, sl, lastSTH)
        irlBearTagBar := na

// ============================================================================
//  OUTCOME LABELS  (W / L on every closed trade)
// ============================================================================
var int lastClosed = 0
if showOutcomes and strategy.closedtrades > lastClosed
    for n = lastClosed to strategy.closedtrades - 1
        pnl   = strategy.closedtrades.profit(n)
        win   = pnl > 0
        exBar = strategy.closedtrades.exit_bar_index(n)
        exPx  = strategy.closedtrades.exit_price(n)
        label.new(exBar, exPx, text = win ? "W" : "L", style = win ? label.style_label_down : label.style_label_up, color = win ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.tiny)
    lastClosed := strategy.closedtrades

// ============================================================================
//  ALERTS  (named after Forever's documented alert categories)
// ============================================================================
alertcondition(irlBullTag, "Internal Range Tag (Bull)", "Bullish IRL tagged")
alertcondition(irlBearTag, "Internal Range Tag (Bear)", "Bearish IRL tagged")
alertcondition(bullCISD,   "CISD (Bull)",  "Bullish CISD detected")
alertcondition(bearCISD,   "CISD (Bear)",  "Bearish CISD detected")
alertcondition(bullSignal, "Model Activated (Bull)", "Bullish Forever model activated")
alertcondition(bearSignal, "Model Activated (Bear)", "Bearish Forever model activated")

// ============================================================================
//  DASHBOARD
// ============================================================================
var table info = table.new(position.top_right, 2, 6, border_width = 1)
if showTable and barstate.islast
    biasTxt  = biasMode + (htfBias == 1 ? " | HTF BULL" : htfBias == -1 ? " | HTF BEAR" : " | HTF —")
    sessTxt  = useSession ? (sessionOK ? "OPEN" : "closed") : "off"
    wins     = 0
    losses   = 0
    if strategy.closedtrades > 0
        for n = 0 to strategy.closedtrades - 1
            if strategy.closedtrades.profit(n) > 0
                wins   += 1
            else
                losses += 1
    wrTxt = strategy.closedtrades > 0 ? str.tostring(wins) + "W / " + str.tostring(losses) + "L" : "—"
    table.cell(info, 0, 0, "Bias",      bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 0, biasTxt,     bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 1, "TF align",  bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 1, htf,         bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 2, "SMT pair",  bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 2, useSMT ? (use2ndSMT ? smtTargetSym + " + " + smtSym2 : smtTargetSym) : "off", bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 3, "Session",   bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 3, sessTxt,     bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 4, "Models",    bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 4, str.tostring(array.size(models)), bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 5, "Trades",    bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 5, wrTxt,       bgcolor = color.new(color.black, 70), text_color = color.white)
