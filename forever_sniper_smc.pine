//@version=5
// Forever-style SMC Sniper Strategy (v2)
//
// Implements the publicly described three-part Forever Model workflow:
//   1. IRL  - Internal Range Liquidity: price tags a Fair Value Gap aligned
//             with the HTF bias FVG.
//   2. SMT  - Smart Money Technique: correlation crack against a paired
//             instrument at the sweep.
//   3. CISD - Change in State of Delivery: a strong-close candle that
//             engulfs the body of a previous directional candle which
//             swept a short-term high or low.
// On a confirmed CISD the prior swept candle becomes the Orderblock (OB);
// stop loss sits beyond the OB extreme; take profit targets External
// Range Liquidity (next major swing) with an OB-multiple fallback.
//
// This is an original implementation of the public concept list and is
// not a reproduction of the proprietary invite-only Pine source.

strategy(
     title              = "Forever-style SMC Sniper",
     shorttitle         = "SMC Sniper",
     overlay            = true,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 10,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.04,
     pyramiding         = 0,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_boxes_count    = 500,
     max_lines_count    = 500,
     max_labels_count   = 500)

// ============================================================================
//  INPUTS
// ============================================================================
gHTF = "1. HTF Bias (IRL source)"
htf            = input.timeframe("240", "HTF",                                       group = gHTF)
useHTFBias     = input.bool(true,         "Require HTF bias alignment",              group = gHTF)
showCE         = input.bool(true,         "Plot CE (FVG midline)",                   group = gHTF)

gIRL = "2. IRL Tag"
requireIRLTag  = input.bool(true,         "Require IRL tag (price into HTF FVG)",    group = gIRL)
maxBarsIRLtoCISD = input.int(40,          "Max bars from IRL tag to CISD",  minval=3, group = gIRL)

gSTR = "3. CISD"
sthLen         = input.int(3,             "Short-term pivot length (STH/STL)", minval=1, group = gSTR)
cisdLookback   = input.int(5,             "CISD: bars back to find sweeper",    minval=1, group = gSTR)

gERL = "4. ERL / Targets"
ltLen          = input.int(10,            "Major pivot length (ERL)",   minval=3, group = gERL)
useERLTarget   = input.bool(true,         "Target next ERL liquidity",          group = gERL)
rrFallback     = input.float(2.0,         "RR fallback if no ERL ahead", minval=0.5, step=0.25, group = gERL)
slBufferTicks  = input.int(2,             "SL buffer (ticks)",   minval=0, group = gERL)

gSMT = "5. SMT Divergence (optional)"
useSMT         = input.bool(false,        "Require SMT divergence at sweep",     group = gSMT)
useAutoSMT     = input.bool(true,         "Auto-detect correlated symbol",       group = gSMT)
smtSym         = input.symbol("CAPITALCOM:US100", "Correlated symbol (manual)",  group = gSMT)
smtInverse     = input.bool(false,        "Inverse correlation",                 group = gSMT)

gSES = "6. Session Filter (killzones)"
useSession     = input.bool(false,        "Trade only inside sessions",          group = gSES)
sess1          = input.session("0200-0500", "Session 1 (London Open)",           group = gSES)
sess2          = input.session("0930-1100", "Session 2 (NY AM)",                 group = gSES)
sess3          = input.session("1330-1600", "Session 3 (NY PM)",                 group = gSES)
sess4          = input.session("2000-2359", "Session 4 (Asia)",                  group = gSES)
sessTZ         = input.string("America/New_York", "Session timezone",            group = gSES)

gVIZ = "7. Visuals"
maxModels      = input.int(40,            "Max model history (formations)", minval=1, maxval=200, group = gVIZ)
showOutcomes   = input.bool(true,         "Show W/L outcome labels",             group = gVIZ)
showHTFFVG     = input.bool(true,         "Plot HTF FVG (IRL) zones",            group = gVIZ)
showLTFFVG     = input.bool(false,        "Plot LTF FVGs (context only)",        group = gVIZ)
showOB         = input.bool(true,         "Plot Orderblock from CISD",           group = gVIZ)
showSignals    = input.bool(true,         "Plot sweep / CISD markers",           group = gVIZ)
showTable      = input.bool(true,         "Dashboard table",                     group = gVIZ)

slBuffer = slBufferTicks * syminfo.mintick

// ============================================================================
//  HTF FVG  -> bias + IRL zones
//      Bullish HTF FVG : low[1]  > high[3]   range = [high[3], low[1]]
//      Bearish HTF FVG : high[1] < low[3]    range = [high[1], low[3]]
// ============================================================================
[htfH1, htfL1, htfH3, htfL3] = request.security(
     syminfo.tickerid, htf, [high[1], low[1], high[3], low[3]],
     lookahead = barmerge.lookahead_off)

htfBull = htfL1 > htfH3
htfBear = htfH1 < htfL3

var float htfBullTop = na, var float htfBullBot = na
var float htfBearTop = na, var float htfBearBot = na
var int   htfBias    = 0
if htfBull
    htfBullTop := htfL1
    htfBullBot := htfH3
    htfBias    := 1
if htfBear
    htfBearTop := htfL3
    htfBearBot := htfH1
    htfBias    := -1

bullCE = (not na(htfBullTop)) ? (htfBullTop + htfBullBot) / 2 : na
bearCE = (not na(htfBearTop)) ? (htfBearTop + htfBearBot) / 2 : na

// ============================================================================
//  IRL TAG  -> price wicks into the latest HTF FVG of the active bias
// ============================================================================
irlBullTag = htfBias ==  1 and not na(htfBullTop) and low  <= htfBullTop and low  >= htfBullBot
irlBearTag = htfBias == -1 and not na(htfBearBot) and high >= htfBearBot and high <= htfBearTop

var int irlBullTagBar = na
var int irlBearTagBar = na
if irlBullTag
    irlBullTagBar := bar_index
if irlBearTag
    irlBearTagBar := bar_index

irlBullActive = not requireIRLTag or (not na(irlBullTagBar) and bar_index - irlBullTagBar <= maxBarsIRLtoCISD)
irlBearActive = not requireIRLTag or (not na(irlBearTagBar) and bar_index - irlBearTagBar <= maxBarsIRLtoCISD)

// ============================================================================
//  SHORT-TERM HIGH / LOW for sweep
// ============================================================================
sth = ta.pivothigh(high, sthLen, sthLen)
stl = ta.pivotlow(low,  sthLen, sthLen)
var float lastSTH = na, var float lastSTL = na
if not na(sth)
    lastSTH := sth
if not na(stl)
    lastSTL := stl

// ============================================================================
//  CISD  -  strong close engulfing body of previous candle that swept STH/STL
// ============================================================================
int sweeperBullIdx = na
int sweeperBearIdx = na
if not na(lastSTL)
    for i = 1 to cisdLookback
        if low[i] < lastSTL and na(sweeperBullIdx)
            sweeperBullIdx := i
if not na(lastSTH)
    for i = 1 to cisdLookback
        if high[i] > lastSTH and na(sweeperBearIdx)
            sweeperBearIdx := i

float swBullOpen  = na(sweeperBullIdx) ? na : open[sweeperBullIdx]
float swBullClose = na(sweeperBullIdx) ? na : close[sweeperBullIdx]
float swBullHigh  = na(sweeperBullIdx) ? na : high[sweeperBullIdx]
float swBullLow   = na(sweeperBullIdx) ? na : low[sweeperBullIdx]

float swBearOpen  = na(sweeperBearIdx) ? na : open[sweeperBearIdx]
float swBearClose = na(sweeperBearIdx) ? na : close[sweeperBearIdx]
float swBearHigh  = na(sweeperBearIdx) ? na : high[sweeperBearIdx]
float swBearLow   = na(sweeperBearIdx) ? na : low[sweeperBearIdx]

// Bullish CISD: current bar green, close engulfs the sweeper's body upward
bullCISD = not na(sweeperBullIdx) and close > open and
           close > math.max(swBullOpen, swBullClose)
bearCISD = not na(sweeperBearIdx) and close < open and
           close < math.min(swBearOpen, swBearClose)

// ============================================================================
//  SMT DIVERGENCE  -  correlated asset failed to make the same sweep
//      Auto-pair: maps the chart symbol to its common SMT counterpart
//      (E-mini cross pairs, FX majors, metals, BTC/ETH). Falls back to the
//      manual symbol when no rule matches.
// ============================================================================
autoSmtPair() =>
    s     = syminfo.ticker
    base  = syminfo.basecurrency
    quote = syminfo.currency
    typ   = syminfo.type
    fut = s == "ES1!" or str.startswith(s, "ES1") ? "CME_MINI:NQ1!" :
          s == "NQ1!" or str.startswith(s, "NQ1") ? "CME_MINI:ES1!" :
          s == "YM1!" ? "CME_MINI:ES1!" :
          s == "RTY1!" ? "CME_MINI:ES1!" : na
    fx  = typ == "forex" ?
          (base == "EUR" and quote == "USD" ? "OANDA:GBPUSD" :
           base == "GBP" and quote == "USD" ? "OANDA:EURUSD" :
           base == "AUD" and quote == "USD" ? "OANDA:NZDUSD" :
           base == "NZD" and quote == "USD" ? "OANDA:AUDUSD" :
           base == "USD" and quote == "JPY" ? "OANDA:USDCHF" :
           base == "USD" and quote == "CHF" ? "OANDA:USDJPY" : na) : na
    met = str.contains(s, "XAU") or str.contains(s, "GOLD")   ? "TVC:SILVER" :
          str.contains(s, "XAG") or str.contains(s, "SILVER") ? "TVC:GOLD"   : na
    cry = str.contains(s, "BTC") ? "BINANCE:ETHUSDT" :
          str.contains(s, "ETH") ? "BINANCE:BTCUSDT" : na
    not na(fut) ? fut : not na(fx) ? fx : not na(met) ? met : not na(cry) ? cry : smtSym

smtTargetSym = useAutoSMT ? autoSmtPair() : smtSym
[smtH, smtL] = request.security(smtTargetSym, timeframe.period, [high, low],
     lookahead = barmerge.lookahead_off)

float smtSweeperLow  = na(sweeperBullIdx) ? na : smtL[sweeperBullIdx]
float smtSweeperHigh = na(sweeperBearIdx) ? na : smtH[sweeperBearIdx]
float smtPriorLow    = na(sweeperBullIdx) ? na : smtL[sweeperBullIdx + 1]
float smtPriorHigh   = na(sweeperBearIdx) ? na : smtH[sweeperBearIdx + 1]

// our chart made a lower low; correlated did NOT (direct correlation)
smtBullDirect = not na(smtSweeperLow)  and not na(smtPriorLow)  and smtSweeperLow  >= smtPriorLow
smtBearDirect = not na(smtSweeperHigh) and not na(smtPriorHigh) and smtSweeperHigh <= smtPriorHigh
// inverse correlation flips the test
smtBullOK = not useSMT or (smtInverse ? not smtBullDirect : smtBullDirect)
smtBearOK = not useSMT or (smtInverse ? not smtBearDirect : smtBearDirect)

// ============================================================================
//  ERL  -  next major swing in trade direction (TP target)
// ============================================================================
ltPH = ta.pivothigh(high, ltLen, ltLen)
ltPL = ta.pivotlow(low,  ltLen, ltLen)
var float lastLTPH = na, var float lastLTPL = na
if not na(ltPH)
    lastLTPH := ltPH
if not na(ltPL)
    lastLTPL := ltPL

// ============================================================================
//  SESSION FILTER
// ============================================================================
inSess(s) => not na(time(timeframe.period, s, sessTZ))
sessionOK = not useSession or inSess(sess1) or inSess(sess2) or inSess(sess3) or inSess(sess4)

// ============================================================================
//  ENTRY  +  MODEL HISTORY (capped ring of OB boxes)
// ============================================================================
htfBullOK = not useHTFBias or htfBias ==  1
htfBearOK = not useHTFBias or htfBias == -1

bullSignal = bullCISD and htfBullOK and irlBullActive and smtBullOK and sessionOK and strategy.position_size == 0
bearSignal = bearCISD and htfBearOK and irlBearActive and smtBearOK and sessionOK and strategy.position_size == 0

var box[] obBoxes = array.new_box()

if bullSignal
    sl   = swBullLow - slBuffer
    risk = close - sl
    if risk > 0
        tpERL = (useERLTarget and not na(lastLTPH) and lastLTPH > close) ? lastLTPH : na
        tp    = na(tpERL) ? close + risk * rrFallback : tpERL
        strategy.entry("L", strategy.long)
        strategy.exit("L-x", "L", stop = sl, limit = tp)
        if showOB
            b = box.new(left = bar_index - sweeperBullIdx, top = swBullHigh,
                 right = bar_index + 12, bottom = swBullLow,
                 bgcolor = color.new(color.teal, 78), border_color = color.new(color.teal, 40))
            array.push(obBoxes, b)
            while array.size(obBoxes) > maxModels
                box.delete(array.shift(obBoxes))
        irlBullTagBar := na

if bearSignal
    sl   = swBearHigh + slBuffer
    risk = sl - close
    if risk > 0
        tpERL = (useERLTarget and not na(lastLTPL) and lastLTPL < close) ? lastLTPL : na
        tp    = na(tpERL) ? close - risk * rrFallback : tpERL
        strategy.entry("S", strategy.short)
        strategy.exit("S-x", "S", stop = sl, limit = tp)
        if showOB
            b = box.new(left = bar_index - sweeperBearIdx, top = swBearHigh,
                 right = bar_index + 12, bottom = swBearLow,
                 bgcolor = color.new(color.maroon, 78), border_color = color.new(color.maroon, 40))
            array.push(obBoxes, b)
            while array.size(obBoxes) > maxModels
                box.delete(array.shift(obBoxes))
        irlBearTagBar := na

// ============================================================================
//  OUTCOME LABELS  (W / L on every closed trade)
// ============================================================================
var int lastClosed = 0
if showOutcomes and strategy.closedtrades > lastClosed
    for n = lastClosed to strategy.closedtrades - 1
        pnl   = strategy.closedtrades.profit(n)
        win   = pnl > 0
        exBar = strategy.closedtrades.exit_bar_index(n)
        exPx  = strategy.closedtrades.exit_price(n)
        label.new(exBar, exPx,
             text      = win ? "W" : "L",
             style     = win ? label.style_label_down : label.style_label_up,
             color     = win ? color.new(color.green, 0) : color.new(color.red, 0),
             textcolor = color.white,
             size      = size.tiny)
    lastClosed := strategy.closedtrades

// ============================================================================
//  LTF FVG visuals (for context only — not a trade trigger here)
// ============================================================================
ltfBullFVG = low > high[2]
ltfBearFVG = high < low[2]
if showLTFFVG and ltfBullFVG
    box.new(left = bar_index - 2, top = low, right = bar_index + 6, bottom = high[2],
         bgcolor = color.new(color.green, 86), border_color = color.new(color.green, 60))
if showLTFFVG and ltfBearFVG
    box.new(left = bar_index - 2, top = low[2], right = bar_index + 6, bottom = high,
         bgcolor = color.new(color.red, 86), border_color = color.new(color.red, 60))

// ============================================================================
//  HTF FVG / CE / signal markers
// ============================================================================
plot(showHTFFVG and not na(htfBullTop) ? htfBullTop : na, "HTF Bull FVG top", color.new(color.green, 30), style = plot.style_linebr)
plot(showHTFFVG and not na(htfBullBot) ? htfBullBot : na, "HTF Bull FVG bot", color.new(color.green, 30), style = plot.style_linebr)
plot(showHTFFVG and not na(htfBearTop) ? htfBearTop : na, "HTF Bear FVG top", color.new(color.red,   30), style = plot.style_linebr)
plot(showHTFFVG and not na(htfBearBot) ? htfBearBot : na, "HTF Bear FVG bot", color.new(color.red,   30), style = plot.style_linebr)
plot(showCE and not na(bullCE) ? bullCE : na, "Bull CE", color.new(color.green, 50), style = plot.style_circles)
plot(showCE and not na(bearCE) ? bearCE : na, "Bear CE", color.new(color.red,   50), style = plot.style_circles)

plotshape(showSignals and irlBullTag, "IRL Bull Tag", shape.diamond,   location.belowbar, color.new(color.lime,   0), size = size.tiny)
plotshape(showSignals and irlBearTag, "IRL Bear Tag", shape.diamond,   location.abovebar, color.new(color.fuchsia,0), size = size.tiny)
plotshape(showSignals and bullCISD,   "Bull CISD",    shape.labelup,   location.belowbar, color.new(color.green,  0), text = "CISD", textcolor = color.white, size = size.tiny)
plotshape(showSignals and bearCISD,   "Bear CISD",    shape.labeldown, location.abovebar, color.new(color.red,    0), text = "CISD", textcolor = color.white, size = size.tiny)

bgcolor(htfBias ==  1 ? color.new(color.green, 95) :
        htfBias == -1 ? color.new(color.red,   95) : na, title = "HTF Bias")

// ============================================================================
//  ALERTS
// ============================================================================
alertcondition(irlBullTag, "IRL Bull Tag",  "Price tagged bullish HTF FVG (IRL)")
alertcondition(irlBearTag, "IRL Bear Tag",  "Price tagged bearish HTF FVG (IRL)")
alertcondition(bullCISD,   "Bull CISD",     "Bullish CISD confirmed")
alertcondition(bearCISD,   "Bear CISD",     "Bearish CISD confirmed")
alertcondition(bullSignal, "Long Entry",    "Forever-style long fired")
alertcondition(bearSignal, "Short Entry",   "Forever-style short fired")

// ============================================================================
//  DASHBOARD
// ============================================================================
var table info = table.new(position.top_right, 2, 7, border_width = 1)
if showTable and barstate.islast
    biasTxt  = htfBias ==  1 ? "BULL" : htfBias == -1 ? "BEAR" : "—"
    biasCol  = htfBias ==  1 ? color.green : htfBias == -1 ? color.red : color.gray
    irlTxt   = irlBullActive and htfBias == 1 ? "Bull armed" : irlBearActive and htfBias == -1 ? "Bear armed" : "—"
    sessTxt  = useSession ? (sessionOK ? "OPEN" : "closed") : "off"
    wins     = 0
    losses   = 0
    if strategy.closedtrades > 0
        for n = 0 to strategy.closedtrades - 1
            if strategy.closedtrades.profit(n) > 0
                wins   += 1
            else
                losses += 1
    wrTxt = strategy.closedtrades > 0 ? str.tostring(wins) + "W / " + str.tostring(losses) + "L" : "—"
    table.cell(info, 0, 0, "HTF Bias",   bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 0, biasTxt,      bgcolor = color.new(biasCol, 70),     text_color = color.white)
    table.cell(info, 0, 1, "IRL",        bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 1, irlTxt,       bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 2, "SMT pair",   bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 2, useSMT ? smtTargetSym : "off",
                                         bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 3, "Last STH",   bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 3, na(lastSTH) ? "—" : str.tostring(lastSTH, format.mintick),
                                         bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 4, "Last STL",   bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 4, na(lastSTL) ? "—" : str.tostring(lastSTL, format.mintick),
                                         bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 5, "Session",    bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 5, sessTxt,      bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 0, 6, "Trades",     bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(info, 1, 6, wrTxt,        bgcolor = color.new(color.black, 70), text_color = color.white)
